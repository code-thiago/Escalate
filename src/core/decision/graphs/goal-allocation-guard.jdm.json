        "x": 340,
        "y": 140
      },
      "content": {
        "hitPolicy": "first",
        "inputs": [
          {
            "id": "in_tier",
            "name": "Asset Liquidity Tier",
            "field": "assetLiquidityTier",
            "defaultValue": ""
          },
          {
            "id": "in_horizon",
            "name": "Goal Horizon (Months)",
            "field": "goalHorizonMonths",
            "defaultValue": ""
          },
          {
            "id": "in_bps",
            "name": "Allocation (bps)",
            "field": "allocationBps",
            "defaultValue": ""
          },
          {
